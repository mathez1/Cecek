# Copy to .env for local runs. In GitHub, these live in
# Settings > Secrets and variables > Actions.

# --- required secrets ---
ANTHROPIC_API_KEY=sk-ant-...

# From the X developer portal, your App > "Keys and tokens".
# The app must be inside a Project and set to "Read and write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- optional settings (shown with their defaults) ---
# Write a post but do not publish it. Always start here.
DRY_RUN=true

# MODEL=claude-opus-5
# EFFORT=high                 # low | medium | high | xhigh | max
# ENABLE_WEB_SEARCH=true      # let the model search and fetch pages
# ALLOW_LINKS=false           # X charges far more for posts containing a URL
# MONTHLY_POST_BUDGET=0       # 0 = no cap. Set one to bound spend.
# FEED_SAMPLE_SIZE=12         # feeds pulled per run
# FEED_ITEMS_PER_SOURCE=6     # headlines taken from each one
# RECENT_POSTS_IN_CONTEXT=40  # how much history the model sees
# MAX_CONSECUTIVE_FAILURES=6  # stop calling Claude after this many failed runs
# MAX_SEARCH_ROUNDS=6         # how long it may keep searching in one run
# ENABLE_REFUSAL_FALLBACK=true  # retry on a fallback model if Claude declines
# LOG_LEVEL=INFO
