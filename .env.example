# Copy to .env for local runs. In GitHub, these live in
# Settings > Secrets and variables > Actions.

# --- required secrets ---
ANTHROPIC_API_KEY=sk-ant-...

# From the X developer portal, your App > "Keys and tokens".
# The app must be inside a Project and set to "Read and write".
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- optional: generated illustrations ---
# Without this the bot still draws charts, which is most of what it draws.
# Leave it unset until you have decided you want the second vendor.
IMAGE_API_KEY=

# --- optional settings (shown with their defaults) ---
# Write a post but do not publish it. Always start here.
DRY_RUN=true

# MODEL=claude-opus-5
# EFFORT=high                 # low | medium | high | xhigh | max
# ENABLE_WEB_SEARCH=true      # let the model search and fetch pages
# ALLOW_LINKS=false           # X charges far more for posts containing a URL
# DAILY_POST_BUDGET=10        # posts per day. 0 = no cap.
# MONTHLY_POST_BUDGET=0       # 0 = no cap. Set one to bound spend.
# MAX_SEARCHES=6              # web searches per run: the main cost lever
# MAX_FETCHES=3               # pages fetched per run
# FEED_SAMPLE_SIZE=12         # feeds pulled per run
# FEED_ITEMS_PER_SOURCE=6     # headlines taken from each one
# RECENT_POSTS_IN_CONTEXT=40  # how much history the model sees
# MAX_CONSECUTIVE_FAILURES=6  # stop calling Claude after this many failed runs
# MAX_SEARCH_ROUNDS=6         # how long it may keep searching in one run
# ENABLE_REFUSAL_FALLBACK=true  # retry on a fallback model if Claude declines
# ENABLE_VISUALS=true         # ask the model whether the post wants a picture
# DAILY_IMAGE_BUDGET=3        # generated illustrations per day. Charts are free
#                             # and uncapped. 0 = no cap.
# IMAGE_MODEL=imagen-4.0-fast-generate-001
# METRICS_WINDOW_DAYS=7      # how far back the view tracker refreshes. Older
#                            # posts keep their last reading. 0 = everything.
# X_USER_ID=                 # the account's numeric id; found and cached for
#                            # you on the tracker's first run
# LOG_LEVEL=INFO
